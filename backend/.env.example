APP_NAME=Mental Health Text Signal API
ENVIRONMENT=development
MODEL_ARTIFACT_PATH=
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=127.0.0.1,localhost
MAX_TEXT_CHARS=5000
MAX_BATCH_SIZE=32
MAX_REQUEST_BYTES=16777216
ENABLE_DOCS=true
DATABASE_PATH=backend/data/mindscope.db
AUTH_REQUIRED=false
SESSION_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=120
